# Copy to `.env` and fill in. `.env` is git-ignored. Never commit real values and never
# reuse production secrets locally.

# --- Application (read by the API; prefix AUREVIA_) ---
AUREVIA_ENVIRONMENT=local
AUREVIA_DEBUG=false
AUREVIA_LOG_LEVEL=INFO
# false = human-readable logs for local development
AUREVIA_LOG_JSON=false
# Required in staging/production. Generate with: openssl rand -hex 32
AUREVIA_JWT_SECRET=
# Both URLs are provided to the API container by docker-compose from the values below.
# Set them yourself only when running the API outside Docker:
#   AUREVIA_DATABASE_URL           the application role (aurevia_app), subject to row-level security
#   AUREVIA_MIGRATION_DATABASE_URL the schema owner, used only by `alembic upgrade`
AUREVIA_DATABASE_URL=
AUREVIA_MIGRATION_DATABASE_URL=

# --- Postgres container (read by docker-compose; all are required) ---
# Use URL-safe passwords, e.g. `openssl rand -hex 24`.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Password for the aurevia_app role, created on first start by docker/postgres/10-app-role.sh.
AUREVIA_APP_DB_PASSWORD=
# Optional: host port for Postgres if 5432 is already in use.
# POSTGRES_HOST_PORT=5433

# --- Browser voice (Phase 2): `docker compose --profile voice up`, then http://localhost:3000 ---
# AI model used by the API's Model Gateway. Only the selected provider's key is needed.
AUREVIA_AI_PROVIDER=gemini
AUREVIA_GEMINI_API_KEY=
# Only when AUREVIA_AI_PROVIDER=anthropic:
AUREVIA_ANTHROPIC_API_KEY=
# Optional overrides. Model default per provider: gemini-3.5-flash / claude-opus-5-5.
# AUREVIA_LLM_MODEL=
# AUREVIA_LLM_EFFORT=low
# AUREVIA_LLM_FALLBACK_POLICY=none   (server_default is Anthropic-only)
# Backup models (same provider), tried in order if a model fails before its first word:
# AUREVIA_LLM_FALLBACK_MODELS=["gemini-3.5-flash-lite"]
# AUREVIA_LLM_FIRST_TOKEN_TIMEOUT_SECONDS=2.5
# LiveKit dev server from docker-compose (dev keys, local only).
AUREVIA_LIVEKIT_URL=http://livekit:7880
AUREVIA_LIVEKIT_PUBLIC_URL=ws://localhost:7880
AUREVIA_LIVEKIT_API_KEY=devkey
AUREVIA_LIVEKIT_API_SECRET=secret
AUREVIA_CORS_ORIGINS=["http://localhost:3000"]
# Optional: host port for the test page if 3000 is in use (then update the CORS origin too).
# VOICE_TEST_PORT=3001
# Speech vendors, used only by the voice-worker container (never the API).
# AUREVIA_STT_PROVIDER=deepgram
# AUREVIA_TTS_PROVIDER=cartesia
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- Phone calls + compliance gate (Phase 6); see docs/02-voice/telephony.md ---------------
# "test" (default) dials only numbers registered under /api/v1/telephony/test-numbers.
# "live" also needs a counsel-reviewed policy pack: until then the gate blocks every live call.
# AUREVIA_TELEPHONY_MODE=test
# Phone calls stay off until both are set (the trunk id comes from LiveKit, after the carrier
# trunk is created there).
AUREVIA_TELEPHONY_PROVIDER=
AUREVIA_LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# AUREVIA_COMPLIANCE_POLICY_PACK=india
# AUREVIA_RING_TIMEOUT_SECONDS=40

# --- Plans and campaigns (Phase 8) ----------------------------------------------------------
# Default limits for tenants without a plan (no payments are taken).
# AUREVIA_PLAN_DEFAULT_MONTHLY_CALLS=200
# AUREVIA_PLAN_DEFAULT_MONTHLY_MINUTES=500
# AUREVIA_PLAN_DEFAULT_MAX_CONCURRENT_CALLS=2
# The automatic campaign dialer: off unless switched on here AND on the campaign.
# AUREVIA_CAMPAIGN_SCHEDULER_ENABLED=false

# --- Rate limits (Phase 9) -------------------------------------------------------------------
# AUREVIA_RATE_LIMIT_API_PER_IP_PER_MINUTE=600
# AUREVIA_RATE_LIMIT_AUTH_PER_IP_PER_MINUTE=30
# AUREVIA_RATE_LIMIT_LOGIN_PER_EMAIL_PER_15_MINUTES=10
# Only behind a reverse proxy you control:
# AUREVIA_TRUST_PROXY_HEADERS=false

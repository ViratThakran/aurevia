# Production-style environment: NAMES ONLY. Copy to deploy/.env on the server, fill in the
# values there, and `chmod 600 deploy/.env`. `.env` is git-ignored: never commit it, never
# paste it into chat. Staging and production must use DIFFERENT values for every secret.
# Generate random secrets with:  openssl rand -hex 32   (database passwords: openssl rand -hex 24)

# --- Where it lives -------------------------------------------------------------------------
# Your domain without "app."/"api."/"rtc.", e.g. example.com. DNS A records for app., api. and
# rtc. must point to the server before the first start (Caddy needs them to get certificates).
AUREVIA_DOMAIN=
# Contact address for the certificate authority (expiry notices).
ACME_EMAIL=
# staging or production (both enforce the secret checks at startup)
AUREVIA_ENVIRONMENT=staging
# AUREVIA_LOG_LEVEL=INFO

# --- Database (Postgres container; URL-safe passwords) ---------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Password of the restricted role the API connects as (created on first start only)
AUREVIA_APP_DB_PASSWORD=

# --- API ---------------------------------------------------------------------------------------
AUREVIA_JWT_SECRET=
# gemini or anthropic; only the selected provider's key is needed
AUREVIA_AI_PROVIDER=gemini
AUREVIA_GEMINI_API_KEY=
AUREVIA_ANTHROPIC_API_KEY=
# AUREVIA_LLM_MODEL=
# AUREVIA_LLM_FALLBACK_MODELS=["gemini-3.5-flash-lite"]

# --- LiveKit (new keys for this server; never devkey/secret) -----------------------------------
# API key is a short name (e.g. "API" + 12 random letters); the secret is >= 32 chars.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Voice worker (speech vendors; used by the worker only) -------------------------------------
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# AUREVIA_STT_PROVIDER=deepgram
# AUREVIA_TTS_PROVIDER=cartesia
# AUREVIA_TTS_VOICE=

# --- Phone calls (stage 5 only; leave blank until the trunk exists) -------------------------------
# Telephony mode (test) and the campaign dialer (off) are fixed in docker-compose.prod.yml.
# AUREVIA_TELEPHONY_PROVIDER=
# AUREVIA_LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# --- Backups to object storage (any S3-compatible service) ---------------------------------------
# Leave BACKUP_S3_BUCKET blank to keep backups on the server only (not recommended).
BACKUP_S3_BUCKET=
# Full https:// endpoint of the service (blank for AWS S3 itself)
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
# Key pair limited to this one bucket (write + list; no delete needed)
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Local copies older than this many days are removed (the bucket's own lifecycle rule handles the rest)
BACKUP_LOCAL_KEEP_DAYS=7
